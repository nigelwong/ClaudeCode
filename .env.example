ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# SEC EDGAR requires a real identifying User-Agent on every request, or it
# will block you. Format: "Your Name your.email@example.com"
SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html --
# used by the market-outlook layer for VIX/yield-curve/credit-spread data.
FRED_API_KEY=

# Optional override; defaults to data/tradesignals.db
TRADESIGNALS_DB_PATH=data/tradesignals.db
